{
  "expo": {
    "name": "SignBridge",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.signtalk.sqjaam",
      "infoPlist": {
        "NSCameraUsageDescription": "Record sign language for translation",
        "NSMicrophoneUsageDescription": "Capture voice for translation to signs",
        "NSContactsUsageDescription": "Share translated messages with contacts",
        "NSPhotoLibraryUsageDescription": "Set your profile photo"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0D0E12"
      },
      "package": "com.emergent.signtalk.sqjaam",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_CONTACTS",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0D0E12"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "expo-audio",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow SignBridge to access your camera to record signs.",
          "microphonePermission": "Allow SignBridge to access your microphone.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow SignBridge to access your contacts to share translations."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow SignBridge to access your photos for profile picture."
        }
      ],
      "expo-sharing",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
